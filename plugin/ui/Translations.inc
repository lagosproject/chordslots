        { u8"Click to audition at the current tempo while playback is stopped.", { u8"Escucha al tempo actual con la reproducci\u00f3n detenida.", u8"\u00c9coutez au tempo actuel quand la lecture est arr\u00eat\u00e9e." } },
        { u8"Apply this performance to the progression", { u8"Aplica este patr\u00f3n a la progresi\u00f3n", u8"Appliquer ce motif \u00e0 la progression" } },
        { u8"Shift-click a chord to listen. Click the timing strip to split a slot. Drag a handle to move it, double-click to lock it, or right-click for more actions.", { u8"May\u00fas + clic para o\u00edr un acorde. Haz clic en la franja de tiempo para dividir. Arrastra un separador para moverlo, haz doble clic para fijarlo o usa el bot\u00f3n derecho para m\u00e1s acciones.", u8"Maj + clic pour \u00e9couter un accord. Cliquez dans la bande temporelle pour scinder. Faites glisser un s\u00e9parateur pour le d\u00e9placer, double-cliquez pour le verrouiller ou faites un clic droit pour plus d\u2019actions." } },
        { u8"Show tonic, scale, length, meter, slots and grid settings.", { u8"Muestra la t\u00f3nica, la escala, la duraci\u00f3n, el comp\u00e1s, los espacios y la cuadr\u00edcula.", u8"Afficher les r\u00e9glages de tonique, de gamme, de dur\u00e9e, de mesure, d\u2019emplacements et de grille." } },
        { u8"Choose the tonic for scale highlighting, suggestions and Roll.", { u8"Elige la t\u00f3nica para el resaltado de la escala, las sugerencias y la generaci\u00f3n.", u8"Choisissez la tonique pour le surlignage de la gamme, les suggestions et la g\u00e9n\u00e9ration." } },
        { u8"Choose the scale for highlighting, suggestions and Roll.", { u8"Elige la escala para el resaltado, las sugerencias y la generaci\u00f3n.", u8"Choisissez la gamme pour le surlignage, les suggestions et la g\u00e9n\u00e9ration." } },
        { u8"Transpose the progression or go to the relative key.", { u8"Transporta la progresi\u00f3n o cambia a la tonalidad relativa.", u8"Transposez la progression ou passez \u00e0 la tonalit\u00e9 relative." } },
        { u8"Set the length of the progression in bars.", { u8"Define la duraci\u00f3n de la progresi\u00f3n en compases.", u8"D\u00e9finissez la dur\u00e9e de la progression en mesures." } },
        { u8"Choose the time signature. Host follows your DAW.", { u8"Elige el comp\u00e1s. DAW sigue el comp\u00e1s del proyecto.", u8"Choisissez la signature rythmique. H\u00f4te suit celle du projet." } },
        { u8"Set the number of chord slots. Use the timeline to add or remove individual cuts.", { u8"Define cu\u00e1ntos espacios para acordes hay. Usa la l\u00ednea de tiempo para a\u00f1adir o quitar separadores.", u8"D\u00e9finissez le nombre d\u2019emplacements d\u2019accords. Ajoutez ou retirez des s\u00e9parateurs dans la timeline." } },
        { u8"Set the note division used to snap timeline cuts.", { u8"Define la subdivisi\u00f3n a la que se ajustan los separadores.", u8"D\u00e9finissez la subdivision sur laquelle s\u2019alignent les s\u00e9parateurs." } },
        { u8"Configure incoming MIDI trigger mode and note mapping", { u8"Configura el modo de disparo MIDI y la asignaci\u00f3n de notas", u8"R\u00e9glez le d\u00e9clenchement MIDI et l\u2019affectation des notes" } },
        { u8"Change editor preferences such as hover help.", { u8"Cambia el idioma y otras preferencias del editor.", u8"Modifiez la langue et les pr\u00e9f\u00e9rences de l\u2019\u00e9diteur." } },
        { u8"Save and browse named chords by category.", { u8"Guarda y consulta acordes por nombre y categor\u00eda.", u8"Enregistrez et parcourez les accords par nom et cat\u00e9gorie." } },
        { u8"How closely the slots match their brightness and tension targets.", { u8"Indica cu\u00e1nto se acercan los acordes a los objetivos de brillo y tensi\u00f3n.", u8"Indique la proximit\u00e9 des accords avec les cibles de brillance et de tension." } },
        { u8"When enabled, editing follows the playing variation", { u8"La edici\u00f3n sigue la variaci\u00f3n en reproducci\u00f3n", u8"L\u2019\u00e9dition suit la variation en cours de lecture" } },
        { u8"Select a variation.", { u8"Selecciona una variaci\u00f3n.", u8"S\u00e9lectionnez une variation." } },
        { u8"Add a variation by copying the current one.", { u8"A\u00f1ade una variaci\u00f3n copiando la actual.", u8"Ajoutez une variation en copiant celle en cours." } },
        { u8"All eight variations are in use.", { u8"Las ocho variaciones est\u00e1n en uso.", u8"Les huit variations sont utilis\u00e9es." } },
        { u8"Copy current variation to another slot", { u8"Copia la variaci\u00f3n actual a otro espacio", u8"Copiez la variation active vers un autre emplacement" } },
        { u8"Show target curves, chord generation controls and locks.", { u8"Muestra las curvas objetivo, la generaci\u00f3n y los bloqueos.", u8"Afficher les courbes cibles, la g\u00e9n\u00e9ration et les verrous." } },
        { u8"Show controls for playing patterns, timing and dynamics.", { u8"Muestra los controles de patrones, tiempo y din\u00e1mica.", u8"Afficher les r\u00e9glages de motifs, de placement et de dynamique." } },
        { u8"Inspect voiced pitches beside the targets. Open Groove & Feel for timing, comping and bass patterns.", { u8"Consulta las notas junto a las curvas. Abre Ritmo para ajustar tiempo, acompa\u00f1amiento y bajo.", u8"Consultez les notes \u00e0 c\u00f4t\u00e9 des courbes. Ouvrez Jeu pour r\u00e9gler le placement, l\u2019accompagnement et la basse." } },
        { u8"Open the menu to see what each preset applies before choosing it.", { u8"Abre el men\u00fa para consultar los cambios de cada ajuste.", u8"Ouvrez le menu pour consulter les r\u00e9glages de chaque pr\u00e9r\u00e9glage." } },
        { u8"All presets replace Brightness, Tension and Energy target curves and generate a progression (also runs a Roll)", { u8"Cada ajuste sustituye las curvas objetivo y genera una progresi\u00f3n", u8"Chaque pr\u00e9r\u00e9glage remplace les courbes cibles et g\u00e9n\u00e8re une progression" } },
        { u8"Choose which chord changes Roll favors. Auto follows the mood and scale. Free removes that preference.", { u8"Elige qu\u00e9 cambios de acorde favorece la generaci\u00f3n. Auto sigue el ambiente y la escala. Libre elimina esa preferencia.", u8"Choisissez les transitions favoris\u00e9es \u00e0 la g\u00e9n\u00e9ration. Auto suit l\u2019ambiance et la gamme. Libre enl\u00e8ve cette pr\u00e9f\u00e9rence." } },
        { u8"Choose how chord notes are spread across registers.", { u8"Elige c\u00f3mo distribuir las notas entre registros.", u8"Choisissez comment r\u00e9partir les notes entre les registres." } },
        { u8"Apply a shape to all three target curves and roll chords to fit it.", { u8"Aplica una forma a las tres curvas y genera acordes que se ajusten a ella.", u8"Appliquez une forme aux trois courbes et g\u00e9n\u00e9rez des accords adapt\u00e9s." } },
        { u8"Browse and audition bass patterns", { u8"Explora y escucha patrones de bajo", u8"Parcourez et \u00e9coutez les motifs de basse" } },
        { u8"Choose the order in which the arp plays the chord voices", { u8"Elige el orden de las voces en el arpegio", u8"Choisissez l\u2019ordre des voix dans l\u2019arp\u00e8ge" } },
        { u8"Set the interval between arpeggio notes", { u8"Ajusta el intervalo entre notas del arpegio", u8"R\u00e9glez l\u2019intervalle entre les notes de l\u2019arp\u00e8ge" } },
        { u8"Set each arp note's length as a percentage of its rate interval", { u8"Define cu\u00e1nto dura cada nota respecto a la divisi\u00f3n del arpegio", u8"R\u00e9glez la dur\u00e9e de chaque note en pourcentage de la division de l\u2019arp\u00e8ge" } },
        { u8"Extend the upper chord voices into higher octaves", { u8"Extiende las voces superiores a octavas m\u00e1s altas", u8"\u00c9tendez les voix sup\u00e9rieures aux octaves plus aigu\u00ebs" } },
        { u8"Set the subdivision between repeated chord hits", { u8"Define la subdivisi\u00f3n entre ataques repetidos", u8"R\u00e9glez la subdivision entre les attaques r\u00e9p\u00e9t\u00e9es" } },
        { u8"Adjust velocity contrast between accents in the comping pattern", { u8"Ajusta el contraste de velocidad entre los acentos", u8"R\u00e9glez le contraste de v\u00e9locit\u00e9 entre les accents du motif" } },
        { u8"Preview only the arp over the current loop while the DAW is stopped", { u8"Escucha solo el arpegio sobre el bucle con el DAW detenido", u8"\u00c9coutez l\u2019arp\u00e8ge seul sur la boucle lorsque le DAW est arr\u00eat\u00e9" } },
        { u8"Save the arp by itself as a MIDI file", { u8"Guarda solo el arpegio como MIDI", u8"Enregistrez l\u2019arp\u00e8ge seul en MIDI" } },
        { u8"Drag the arp by itself onto a MIDI track in your DAW", { u8"Arrastra solo el arpegio a una pista MIDI", u8"Glissez l\u2019arp\u00e8ge seul sur une piste MIDI" } },
        { u8"Set all three target curves to 50% and roll chords to fit them.", { u8"Pon las tres curvas al 50 % y genera acordes acordes a ellas.", u8"R\u00e9glez les trois courbes \u00e0 50 % et g\u00e9n\u00e9rez des accords adapt\u00e9s." } },
        { u8"Choose a MIDI melody to harmonize, or drop a MIDI file in Harmony", { u8"Elige una melod\u00eda MIDI o suelta el archivo en Armon\u00eda", u8"Choisissez une m\u00e9lodie MIDI ou d\u00e9posez un fichier dans Harmonie" } },
        { u8"Extract target curves from MIDI or clear the imported melody", { u8"Extrae curvas del MIDI o borra la melod\u00eda importada", u8"Extrayez les courbes du MIDI ou effacez la m\u00e9lodie import\u00e9e" } },
        { u8"Preview melody, chords and bass over the current loop while the DAW is stopped", { u8"Escucha melod\u00eda, acordes y bajo con el DAW detenido", u8"\u00c9coutez m\u00e9lodie, accords et basse lorsque le DAW est arr\u00eat\u00e9" } },
        { u8"Switch between the file's original beat positions and scaling the phrase to the loop", { u8"Alterna entre el tiempo original y el ajuste al bucle", u8"Alternez entre le placement d\u2019origine et l\u2019adaptation \u00e0 la boucle" } },
        { u8"Use the detected key and scale to harmonize the melody", { u8"Armoniza con la tonalidad y escala detectadas", u8"Harmonisez avec la tonalit\u00e9 et la gamme d\u00e9tect\u00e9es" } },
        { u8"Standalone tempo. To stretch an imported phrase, use Fit to Loop in Melody MIDI.", { u8"Tempo de la aplicaci\u00f3n. Usa Ajustar al bucle para adaptar una frase importada.", u8"Tempo autonome. Utilisez Adapter \u00e0 la boucle pour \u00e9tirer une phrase import\u00e9e." } },
        { u8"Set how strongly Roll favors chords that fit the imported melody. Set to 0% to ignore it.", { u8"Controla cu\u00e1nto influye la melod\u00eda importada en la generaci\u00f3n. Pon 0 % para ignorarla.", u8"R\u00e9glez l\u2019influence de la m\u00e9lodie import\u00e9e sur la g\u00e9n\u00e9ration. Utilisez 0 % pour l\u2019ignorer." } },
        { u8"Generation locks apply across the progression when rolling. Chord locks preserve one chord; separator locks protect one timing boundary.", { u8"Los bloqueos de generaci\u00f3n afectan a toda la progresi\u00f3n. Los de acorde conservan un acorde y los de separador fijan una divisi\u00f3n temporal.", u8"Les verrous de g\u00e9n\u00e9ration concernent toute la progression. Les verrous d\u2019accord pr\u00e9servent un accord et les s\u00e9parateurs verrouill\u00e9s fixent une coupure temporelle." } },
        { u8"Locks rhythm and slot cut positions during Roll", { u8"Conserva el ritmo y los cortes al generar", u8"Conserve le rythme et les coupures \u00e0 la g\u00e9n\u00e9ration" } },
        { u8"Locks chord root notes during Roll", { u8"Conserva las fundamentales al generar", u8"Conserve les fondamentales \u00e0 la g\u00e9n\u00e9ration" } },
        { u8"Locks chord types and qualities during Roll", { u8"Conserva los tipos de acorde al generar", u8"Conserve les qualit\u00e9s d\u2019accord \u00e0 la g\u00e9n\u00e9ration" } },
        { u8"Locks inversions and voice registers during Roll", { u8"Conserva las inversiones y registros al generar", u8"Conserve les renversements et registres \u00e0 la g\u00e9n\u00e9ration" } },
        { u8"Across the progression: ", { u8"En toda la progresi\u00f3n: ", u8"Dans toute la progression : " } },
        { u8"Harmonic ending preference for the next Roll.", { u8"Preferencia de final arm\u00f3nico para la pr\u00f3xima generaci\u00f3n.", u8"Pr\u00e9f\u00e9rence de fin harmonique pour la prochaine g\u00e9n\u00e9ration." } },
        { u8"Raise this to let Roll use more borrowed chords and extensions.", { u8"Aumenta el uso de acordes prestados y extensiones.", u8"Augmentez le recours aux accords emprunt\u00e9s et aux extensions." } },
        { u8"Raise this to explore more chord choices each time you Roll.", { u8"Sube este valor para explorar m\u00e1s acordes al generar.", u8"Augmentez la valeur pour explorer plus d\u2019accords \u00e0 chaque g\u00e9n\u00e9ration." } },
        { u8"Raise this to move more unlocked chord changes off the regular beat during Roll.", { u8"Desplaza m\u00e1s cambios de acorde libres fuera del pulso al generar.", u8"D\u00e9calez davantage de changements d\u2019accord libres hors du temps \u00e0 la g\u00e9n\u00e9ration." } },
        { u8"Raise this to let Roll use inversions for smoother movement between bass notes.", { u8"Usa m\u00e1s inversiones para suavizar el movimiento del bajo.", u8"Utilisez davantage de renversements pour fluidifier la basse." } },
        { u8"Spread the upper chord notes in time. Positive plays low to high. Negative plays high to low.", { u8"Separa las notas en el tiempo. Positivo: de grave a agudo. Negativo: de agudo a grave.", u8"\u00c9talez les notes dans le temps. Positif : du grave \u00e0 l\u2019aigu. N\u00e9gatif : de l\u2019aigu au grave." } },
        { u8"Raise this to emphasize the highest chord note and soften the inner notes.", { u8"Resalta la nota m\u00e1s aguda y suaviza las voces internas.", u8"Accentuez la note la plus aigu\u00eb et att\u00e9nuez les voix int\u00e9rieures." } },
        { u8"Add small variations in note timing and velocity for a more natural feel.", { u8"A\u00f1ade variaciones de tiempo y velocidad para un toque natural.", u8"Ajoutez de petites variations de placement et de v\u00e9locit\u00e9 pour un jeu plus naturel." } },
        { u8"Set how long notes are held relative to their rhythmic duration.", { u8"Define cu\u00e1nto se sostienen las notas en relaci\u00f3n con su duraci\u00f3n r\u00edtmica.", u8"R\u00e9glez la tenue des notes par rapport \u00e0 leur dur\u00e9e rythmique." } },
        { u8"Adjust the loudness of the built-in preview instrument.", { u8"Ajusta el volumen del instrumento de escucha integrado.", u8"R\u00e9glez le volume de l\u2019instrument d\u2019\u00e9coute int\u00e9gr\u00e9." } },
        { u8"Browse comping performances and audition their rhythms", { u8"Explora acompa\u00f1amientos y escucha sus ritmos", u8"Parcourez les accompagnements et \u00e9coutez leurs rythmes" } },
        { u8"Choose the instrument sound for the built-in preview.", { u8"Elige el sonido para la escucha integrada.", u8"Choisissez le son de l\u2019instrument d\u2019\u00e9coute." } },
        { u8"Roll a different chord rhythm while keeping the harmony and bass pattern.", { u8"Genera otro ritmo de acordes y conserva la armon\u00eda y el patr\u00f3n de bajo.", u8"Changez le rythme des accords en conservant l'harmonie et le motif de basse." } },
        { u8"Start with chords or roll new chords for all unlocked slots", { u8"Genera acordes nuevos en los espacios desbloqueados", u8"G\u00e9n\u00e9rez de nouveaux accords aux emplacements d\u00e9verrouill\u00e9s" } },
