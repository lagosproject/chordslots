        { u8"Chord lock: this chord on Roll; separator lock: timing", { u8"Bloqueo de acorde: generaci\u00f3n \u00b7 Bloqueo de separador: tiempo", u8"Verrou d\u2019accord : g\u00e9n\u00e9ration \u00b7 Verrou de s\u00e9parateur : temps" } },
        { u8"Chord lock: this slot. Separator lock: a timing boundary. Generation locks: the whole progression.", { u8"Bloqueo de acorde: este espacio. De separador: un corte temporal. De generaci\u00f3n: toda la progresi\u00f3n.", u8"Verrou d\u2019accord : cet emplacement. Verrou de s\u00e9parateur : une coupure. Verrous de g\u00e9n\u00e9ration : toute la progression." } },
        { u8"Set chord root. This pitch is a safe melody note for the current chord.", { u8"Elige la fundamental. Esta nota es compatible con el acorde actual.", u8"Choisissez la fondamentale. Cette note est compatible avec l\u2019accord actuel." } },
        { u8"Set chord root.", { u8"Elige la fundamental del acorde.", u8"Choisissez la fondamentale de l\u2019accord." } },
        { u8"Set the note in the separate bass part.", { u8"Elige la nota de la parte de bajo.", u8"Choisissez la note de la partie de basse." } },
