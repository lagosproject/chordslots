        { u8"Drag just the upper chord notes onto a MIDI track in your DAW.", { u8"Arrastra solo las voces superiores a una pista MIDI.", u8"Glissez les voix sup\u00e9rieures seules sur une piste MIDI." } },
        { u8"Drag just the bass notes onto a MIDI track in your DAW.", { u8"Arrastra solo las notas del bajo a una pista MIDI.", u8"Glissez uniquement les notes de basse sur une piste MIDI." } },
