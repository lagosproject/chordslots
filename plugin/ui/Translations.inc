        { u8"Show or hide the settings for Roll.", { u8"Muestra u oculta los ajustes de generaci\u00f3n.", u8"Affichez ou masquez les r\u00e9glages de g\u00e9n\u00e9ration." } },
        { u8"Use the MIDI file's first tempo when importing. Enter a BPM to switch to manual tempo.", { u8"Usa el primer tempo del archivo importado. Introduce un BPM para seleccionar el tempo manualmente.", u8"Utilise le premier tempo du fichier import\u00e9. Saisissez une valeur BPM pour passer au tempo manuel." } },
        { u8"The chord bank could not be saved to disk.", { u8"No se pudo guardar el banco de acordes en el disco.", u8"Impossible d\u2019enregistrer la banque d\u2019accords sur le disque." } },
